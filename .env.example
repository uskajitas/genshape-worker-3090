# Worker identity (matches server's in-memory registry).
WORKER_ID=win-3090
WORKER_MODELS=hunyuan3d,triposr,sf3d,hi3dgen
WORKER_CAPACITY=1

# Server endpoint (the genshape3d API).
WORKER_API_BASE=https://api.genshape3d.com
# Same value the server has in its .env. Get from i7 agent's password-manager
# entry "genshape3d WORKER_AUTH_TOKEN".
WORKER_AUTH_TOKEN=

# Cloudflare R2 (same bucket the server + 1080 worker write to).
R2_ENDPOINT=https://edad30fa0fe66f50971087c6b0df0f28.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=genshape3d
R2_PUBLIC_URL=https://edad30fa0fe66f50971087c6b0df0f28.r2.cloudflarestorage.com/genshape3d

# HuggingFace token — needed by runners to download gated model weights
# (Hunyuan3D, TripoSR, SF3D, Hi3DGen all require accepting a license on the
# model's HF page first). Create at https://huggingface.co/settings/tokens
# (Read scope is sufficient).
HF_TOKEN=
